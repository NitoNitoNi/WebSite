@model MyMvcApp.Models.DataModel.Accounts

@{
    ViewData["Title"] = (Model.AccountsId == 0 ? "➕ Создание" : "✏️ Редактирование") + " аккаунта";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="mb-0 text-center">
                        <i class="bi bi-person-plus me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" action="/Accounts/EditPost">
                        <input type="hidden" name="AccountsId" value="@Model.AccountsId" />
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <!-- Логин -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-person-fill text-primary me-1"></i> Логин
                            </label>
                            <input type="text" name="Login" value="@Model.Login" class="form-control form-control-lg rounded-3" placeholder="Введите логин" required />
                        </div>

                        <!-- Пароль -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-key-fill text-primary me-1"></i> Пароль
                            </label>
                            <input type="password" name="Pass" value="@(Model.AccountsId == 0 ? "" : Model.Pass)" class="form-control form-control-lg rounded-3" placeholder="@(Model.AccountsId == 0 ? "Введите пароль" : "Оставьте пустым, если не меняете")" @(Model.AccountsId == 0 ? "required" : "") />
                            @if (Model.AccountsId != 0)
                            {
                                <div class="form-text text-muted">Оставьте поле пустым, чтобы сохранить текущий пароль</div>
                            }
                        </div>

                        <!-- Активен -->
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActiveSwitch" @(Model.IsActive == true ? "checked" : "") />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                <i class="bi bi-check-circle-fill text-success me-1"></i> Активен
                            </label>
                        </div>

                        <!-- Сотрудник (Select2) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-person-badge text-primary me-1"></i> Сотрудник
                            </label>
                            <select name="EmployeeId" class="form-select form-select-lg rounded-3 select2" required>
                                <option value="">-- Выберите сотрудника --</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">
                                            @emp.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Ресурс (Select2) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-grid-3x3-gap-fill text-primary me-1"></i> Ресурс
                            </label>
                            <select name="ResourceId" class="form-select form-select-lg rounded-3 select2" required>
                                <option value="">-- Выберите ресурс --</option>
                                @if (ViewBag.Resources != null)
                                {
                                    foreach (var res in ViewBag.Resources)
                                    {
                                        <option value="@res.ResourcesId" selected="@(Model.ResourceId == res.ResourcesId)">
                                            @res.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex justify-content-between gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-4 rounded-pill flex-fill">
                                <i class="bi bi-save me-2"></i> Сохранить
                            </button>
                            <a href="@(ViewBag.ReturnUrl ?? "/Accounts/Index")" class="btn btn-outline-secondary btn-lg px-4 rounded-pill flex-fill">
                                <i class="bi bi-x-circle me-2"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f0f7ff; }
        .card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .card:hover { transform: translateY(-3px); box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1) !important; }
        .form-control:focus, .form-select:focus { border-color: #0d6efd; box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25); }
        .btn-primary { background: linear-gradient(135deg, #0d6efd, #0a58ca); border: none; }
        .btn-primary:hover { background: linear-gradient(135deg, #0b5ed7, #084298); transform: scale(1.02); }
        .btn-outline-secondary:hover { background-color: #e9ecef; transform: scale(1.02); }
        /* Select2 настройки для Bootstrap 5 */
        .select2-container .select2-selection--single { height: auto; padding: 0.5rem 0.75rem; font-size: 1rem; border-radius: 0.5rem; border-color: #ced4da; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 1.5; color: #212529; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 100%; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                placeholder: "Выберите значение",
                allowClear: true,
                width: '100%',
                language: "ru"
            });
        });
    </script>
}