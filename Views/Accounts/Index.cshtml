@model List<MyMvcApp.Models.DataModel.Accounts>

@{
    ViewData["Title"] = "Список аккаунтов";
}

<h2>Список аккаунтов</h2>

<p>
    <a href="/Accounts/Create" class="btn btn-primary">Создать аккаунт</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Логин</th>
            <th>Дата создания</th>
            <th>Активен</th>
            <th>Сотрудник ID</th>
            <th>Ресурс ID</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var acc in Model)
        {
            <tr>
                <td>@acc.AccountsId</td>
                <td>@acc.Login</td>
                <td>@acc.Data.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(acc.IsActive == true ? "Да" : "Нет")</td>
                <td>@acc.EmployeeId</td>
                <td>@acc.ResourceId</td>
                <td>
                    <a href="/Accounts/Edit/@acc.AccountsId">Редактировать</a> |
                    <a href="/Accounts/Delete/@acc.AccountsId" onclick="return confirm('Удалить аккаунт?')">Удалить</a>
                 </td>
            </tr>
        }
    </tbody>
</table>