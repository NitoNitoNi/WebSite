@model MyMvcApp.Models.DataModel.Employee
@{
    ViewData["Title"] = $"Профиль сотрудника - {Model.Name}";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>Информация о сотруднике</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ФИО:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Должность:</dt>
                        <dd class="col-sm-8">@Model.Position</dd>

                        <dt class="col-sm-4">Отделение:</dt>
                        <dd class="col-sm-8">@(Model.Deparment?.Name ?? "Не указано")</dd>

                        <dt class="col-sm-4">Описание:</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Статус:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Неактивен</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <h4>Аккаунты сотрудника</h4>
                </div>
                <div class="card-body">
                    @if (Model.Accounts != null && Model.Accounts.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ресурс</th>
                                    <th>URL</th>
                                    <th>Логин</th>
                                    <th>Пароль</th>
                                    <th>Дата создания</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var acc in Model.Accounts)
                                {
                                    <tr>
                                        <td>@acc.ResourceName</td>
                                        <td><a href="@acc.ResourceUrl" target="_blank">@acc.ResourceUrl</a></td>
                                        <td>@acc.Login</td>
                                        <td>
                                            <span id="password-mask-@acc.AccountsId">•••••••</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary copy-pwd-btn" data-id="@acc.AccountsId">Копировать</button>
                                        </td>
                                        <td>@acc.Data.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@if (acc.IsActive == true)
                                            {
                                                <span class="badge bg-success">Активен</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Неактивен</span>
                                            }
                                        </td>

                                        <td>
                                            <a href="/Accounts/Edit/@acc.AccountsId?returnUrl=@Context.Request.Path" class="btn btn-sm btn-primary">Ред.</a>
                                            <a href="/Accounts/Delete/@acc.AccountsId?returnUrl=@Context.Request.Path" class="btn btn-sm btn-danger">Уд.</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">У сотрудника нет аккаунтов.</div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a href="/Employee/Edit/@Model.EmployeeId" class="btn btn-warning">Редактировать</a>
                <a href="/Employee/Index" class="btn btn-secondary">Назад</a>
                <a href="/Accounts/Create?employeeId=@Model.EmployeeId&returnUrl=@Context.Request.Path" class="btn btn-success">Создать аккаунт</a>
                @if (User.IsInRole("Admin")){
                    <a href="/Employee/Delete/@Model.EmployeeId" class="btn btn-outline-danger" title="Удалить" onclick="return confirm('Удалить сотрудника?');">Удалить сотрудника</a>
                }
                
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.copy-pwd-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const accountId = this.getAttribute('data-id');
                try {
                    const response = await fetch(`/Accounts/GetPassword?id=${accountId}`);
                    if (response.ok) {
                        const data = await response.json();
                        const password = data.password;
                        await navigator.clipboard.writeText(password);
                        alert('Пароль скопирован в буфер обмена');
                    } else {
                        alert('Не удалось получить пароль');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Ошибка при копировании');
                }
            });
        });
    </script>
}