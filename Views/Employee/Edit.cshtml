@model MyMvcApp.Models.DataModel.Employee
@{
    ViewData["Title"] = (Model.EmployeeId == 0 ? "➕ Добавление" : "✏️ Редактирование") + " сотрудника";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="mb-0 text-center">
                        <i class="bi bi-person-badge me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" action="/Employee/EditPost">
                        <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />

                        <!-- ФИО сотрудника -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-person-fill text-primary me-1"></i> ФИО сотрудника
                            </label>
                            <input type="text" name="Name" value="@Model.Name" class="form-control form-control-lg rounded-3" placeholder="Введите полное имя" required />
                        </div>

                        <!-- Должность -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-briefcase-fill text-primary me-1"></i> Должность
                            </label>
                            <input type="text" name="Position" value="@Model.Position" class="form-control form-control-lg rounded-3" placeholder="Например: Врач, Медсестра" required />
                        </div>

                        <!-- Описание -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-file-text-fill text-primary me-1"></i> Описание
                            </label>
                            <textarea name="Description" class="form-control rounded-3" rows="3" placeholder="Краткая информация о сотруднике">@Model.Description</textarea>
                        </div>

                        <!-- Активен (чекбокс) -->
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActiveSwitch" @(Model.IsActive == true ? "checked" : "") />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                <i class="bi bi-check-circle-fill text-success me-1"></i> Активен
                            </label>
                        </div>

                        <!-- Отделение (выпадающий список) -->
                        <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-building text-primary me-1"></i> Отделение
                        </label>
                        <select name="DeparmentId" class="form-select form-select-lg rounded-3 select2" required>
                            <option value="">-- Выберите отделение --</option>
                            @if (ViewBag.Departments != null)
                            {
                                var depts = ViewBag.Departments as List<MyMvcApp.Models.DataModel.Deparment>;
                                if (depts != null)
                                {
                                    foreach (var dept in depts)
                                    {
                                        if (Model.DeparmentId == dept.DeparmentId)
                                        {
                                            <option value="@dept.DeparmentId" selected>@dept.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@dept.DeparmentId">@dept.Name</option>
                                        }
                                    }
                                }
                            }
                        </select>
                    </div>

                        <!-- Кнопки действий -->
                        <div class="d-flex justify-content-between gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-4 rounded-pill flex-fill">
                                <i class="bi bi-save me-2"></i> Сохранить
                            </button>
                            <a href="/Employee/Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill flex-fill">
                                <i class="bi bi-x-circle me-2"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f0f7ff;
        }
        .card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1) !important;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        .btn-primary {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #0b5ed7, #084298);
            transform: scale(1.02);
        }
        .btn-outline-secondary:hover {
            background-color: #e9ecef;
            transform: scale(1.02);
        }
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}
    @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                placeholder: "Выберите отделение",
                allowClear: true,
                width: '100%',
                language: "ru"
            });
        });
    </script> 
}