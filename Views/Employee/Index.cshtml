@model List<MyMvcApp.Models.DataModel.Employee>

@{
    ViewData["Title"] = "Сотрудники";
}

<div class="container-fluid mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="mb-0">👥 Сотрудники</h2>
        </div>
        <div class="col-md-6 text-md-end">
            <a href="/Employee/Create" class="btn btn-success btn-lg">
                <i class="bi bi-person-plus-fill"></i> Добавить сотрудника
            </a>
        </div>
    </div>

    <!-- Карточка поиска -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Поиск по ФИО..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Найти
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-repeat"></i> Сбросить
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Карточка со списком сотрудников -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>ФИО</th>
                            <th>Должность</th>
                            <th>Отделение</th>
                            <th>Статус</th>
                            <th class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var emp in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@emp.EmployeeId</td>
                                    <td>@emp.Name</td>
                                    <td>@emp.Position</td>
                                    <td>@(emp.Deparment?.Name ?? "—")</td>
                                    <td>
                                        @if (emp.IsActive == true)
                                        {
                                            <span class="badge bg-success rounded-pill">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">Неактивен</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="/Employee/Profile/@emp.EmployeeId" class="btn btn-outline-info" title="Профиль">
                                                <i class="bi bi-person-badge"></i>
                                            </a>
                                            <a href="/Employee/Edit/@emp.EmployeeId" class="btn btn-outline-warning" title="Редактировать">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a href="/Employee/Delete/@emp.EmployeeId" class="btn btn-outline-danger" title="Удалить" onclick="return confirm('Удалить сотрудника?');">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1 d-block"></i> Сотрудники не найдены
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.CurrentSearch">
                                    <i class="bi bi-chevron-left"></i> Назад
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch">@i</a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.CurrentSearch">
                                    Вперёд <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .table-hover tbody tr:hover {
            background-color: #0d6efd;
            transition: background-color 0.2s ease;
        }
        .btn-group .btn {
            margin: 0 2px;
        }
        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
        .pagination .page-link {
            color: #0d6efd;
        }
        .pagination .active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: white;
        }
        .badge {
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
    </style>
}