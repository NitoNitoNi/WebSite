@using Microsoft.AspNetCore.Authorization

@{
    ViewData["Title"] = "Список сотрудников";
}

    @model List<MyMvcApp.Models.DataModel.Employee>

    <h2>Список сотрудников</h2>

@if(TempData["SuccessMessage"] !=null)
{
    <div>@TempData["SuccessMessage"]</div>
}
@if(TempData["ErrorMessage"] !=null)
{
    <div>@TempData["ErrorMessage"]</div>
}


    <p>
        <a href="/Employee/Create">Добавить</a>
    </p>


    <div class="employee-list">
        @foreach (var employee in Model){
            <div class="employee-item">
                <div class="employee-info">
                    <div class="emloyee-position">@employee.Position</div>
                    <div class="emloyee-name">@employee.Name</div>
                </div>
                <div class="employee-actions">
                    <a href="/Employee/Profile?id=@employee.EmployeeId" class="btn-profile">Профиль</a> |
                    <a href="/Employee/Delete?id=@employee.EmployeeId" class="btn-delete" onclick="return confirm('Вы уверены, что хотите удалить этого сотрудника?')">Удалить</a>
                </div>
            </div>
        }
    </div>



