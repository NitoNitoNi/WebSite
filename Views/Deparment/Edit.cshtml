@using Microsoft.AspNetCore.Authorization

@{
	ViewData["Title"] = "Добавление/Редактирование отделения";
}

@model MyMvcApp.Models.DataModel.Deparment
<h2>@(Model.DeparmentId == 0 ? "Добавление" : "Редактирование") отделения</h2>
<div class="list">

    <form method="post" action="/Deparment/EditPost/">
        <div>
            <input type="hidden" name="DeparmentId" value="@Model.DeparmentId" />
            <label>Название отделения</label>
            <input name="Name" value="@Model.Name" />
            @Html.ValidationMessageFor(m=>m.Name)
        </div>
        
        <div>
            <button class="dropbtn">Сохранить</button>
        </div>
    </form>
</div>

	


