@model List<MyMvcApp.Models.DataModel.AuditLog>

@{
    ViewData["Title"] = "Журнал действий";
}

<div class="container-fluid mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="mb-0"><i class="bi bi-journal-bookmark-fill me-2"></i> Журнал действий</h2>
        </div>
    </div>

    <!-- Карточка поиска -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Поиск по пользователю, действию, сущности..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" placeholder="Дата с" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" placeholder="Дата по" />
                </div>
                <div class="col-md-2">
                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Найти
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-repeat"></i> Сбросить
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Карточка с таблицей логов -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-primary">
                        <tr>
                            <td>Время</td>
                            <td>Пользователь</td>
                            <td>Действие</td>
                            <td>Сущность</td>
                            <td>ID записи</td>
                            <td>Детали</td>
                            <td>IP-адрес</td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                                    <td>@log.UserName</td>
                                    <td>@log.Action</td>
                                    <td>@log.EntityType</td>
                                    <td>@log.EntityId</td>
                                    <td>@(log.Details ?? "—")</td>
                                    <td>@log.IpAddress</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1 d-block"></i> Записи не найдены
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.CurrentSearch" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">
                                    <i class="bi bi-chevron-left"></i> Назад
                                </a>
                            </li>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.CurrentSearch" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">@i</a>
                            </li>
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.CurrentSearch" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">
                                    Вперёд <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f0f7ff;
        }
        .card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border: none;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1) !important;
        }
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        .btn-group .btn {
            margin: 0 2px;
        }
        .pagination .page-link {
            color: #0d6efd;
        }
        .pagination .active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: white;
        }
        .btn-primary {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #0b5ed7, #084298);
            transform: scale(1.02);
        }
        .btn-success {
            background: linear-gradient(135deg, #198754, #146c43);
            border: none;
        }
        .btn-success:hover {
            transform: scale(1.02);
        }
    </style>
}