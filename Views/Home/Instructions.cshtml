@{
    ViewData["Title"] = "Инструкция пользователя";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-4 fw-bold text-primary">
                <i class="bi bi-question-circle-fill me-3"></i>Инструкция пользователя
            </h1>
            <p class="lead text-muted">Как работать с системой «Хранитель»</p>
            <hr class="w-25 mx-auto" />
        </div>
    </div>

    <!-- Разделы инструкции -->
    <div class="row g-4">
        <!-- 1. Вход в систему -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-box-arrow-in-right text-primary fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Вход в систему</h4>
                    <p class="card-text text-muted">
                        Используйте свой email и пароль, полученные от администратора.
                        При первом входе рекомендуется сменить пароль в профиле.
                    </p>
                </div>
            </div>
        </div>

        <!-- 2. Профиль пользователя -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-person-circle text-success fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Профиль пользователя</h4>
                    <p class="card-text text-muted">
                        В профиле можно сменить пароль, просмотреть свою роль, а также удалить аккаунт (с осторожностью!).
                    </p>
                </div>
            </div>
        </div>

        <!-- 3. Сотрудники -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-people-fill text-info fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Сотрудники</h4>
                    <p class="card-text text-muted">
                        Просмотр списка сотрудников, профилей. Администратор может добавлять, редактировать и удалять сотрудников.
                    </p>
                </div>
            </div>
        </div>

        <!-- 4. Отделения -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-building-fill text-warning fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Отделения</h4>
                    <p class="card-text text-muted">
                        Управление структурными подразделениями. Только администратор может создавать и изменять отделения.
                    </p>
                </div>
            </div>
        </div>

        <!-- 5. Ресурсы -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-grid-3x3-gap-fill text-danger fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Ресурсы</h4>
                    <p class="card-text text-muted">
                        Медицинские порталы и сервисы. Администратор добавляет и редактирует ресурсы. Аккаунты привязываются к ресурсам.
                    </p>
                </div>
            </div>
        </div>

        <!-- 6. Аккаунты -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-person-badge-fill text-secondary fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Аккаунты</h4>
                    <p class="card-text text-muted">
                        Учётные записи сотрудников для доступа к ресурсам. Администратор создаёт, редактирует и удаляет аккаунты.
                    </p>
                </div>
            </div>
        </div>

        <!-- 7. Журнал действий -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-dark bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-journal-bookmark-fill text-dark fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Журнал действий</h4>
                    <p class="card-text text-muted">
                        Администратор может просматривать все действия пользователей: кто, когда и что делал.
                    </p>
                </div>
            </div>
        </div>

        <!-- 8. Безопасность -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Безопасность</h4>
                    <p class="card-text text-muted">
                        Пароли аккаунтов хранятся в зашифрованном виде. Не сообщайте свои пароли третьим лицам.
                    </p>
                </div>
            </div>
        </div>

        <!-- 9. Помощь -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 d-inline-flex mb-3">
                        <i class="bi bi-envelope-paper-fill text-info fs-1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Техподдержка</h4>
                    <p class="card-text text-muted">
                        При возникновении проблем обращайтесь к системному администратору по email: <strong>support@hranitel.ru</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>


    <div class="row mt-5">
        <div class="col-12 text-center">
            <div class="alert alert-primary border-0 rounded-4 shadow-sm">
                <i class="bi bi-info-circle-fill me-2"></i>
                Версия системы 1.0 | Актуально на @DateTime.Now.ToString("dd.MM.yyyy")
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f0f7ff;
        }
        .transition-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .transition-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1) !important;
        }
        .rounded-circle {
            width: 70px;
            height: 70px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-outline-primary:hover {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: white;
        }
    </style>
}