@model MyMvcApp.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Профиль";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-primary text-white py-4" style="background: linear-gradient(135deg, #0d6efd, #0099ff);">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle fs-1 me-3"></i>
                        <h3 class="mb-0 fw-bold">Профиль пользователя</h3>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                    <i class="bi bi-shield-lock-fill text-primary fs-5"></i>
                                </div>
                                <div>
                                    <label class="text-muted small mb-0">Роль</label>
                                    <p class="fw-semibold mb-0 fs-5">
                                        @if (ViewBag.UserRole != null)
                                        {
                                            @ViewBag.UserRole
                                        }
                                        else
                                        {
                                            <span class="text-muted">Не определена</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                                    <i class="bi bi-envelope-fill text-info fs-5"></i>
                                </div>
                                <div>
                                    <label class="text-muted small mb-0">Email</label>
                                    <p class="fw-semibold mb-0 fs-5">@Model.Email</p>
                                </div>
                            </div>
                        </div>
                    </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <a href="/Account/ChangePassword" class="btn btn-outline-warning rounded-pill px-4 flex-grow-1 text-center">
                        <i class="bi bi-key-fill me-2"></i> Сменить пароль
                    </a>

                    <form asp-action="Logout" method="post" class="d-inline flex-grow-1">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 w-100">
                            <i class="bi bi-box-arrow-right me-2"></i> Выйти
                        </button>
                    </form>

                    <form asp-action="DeleteAccount" method="post" class="d-inline flex-grow-1" onsubmit="return confirm('Вы уверены, что хотите навсегда удалить свой аккаунт? Это действие необратимо.');">
                        <button type="submit" class="btn btn-outline-dark rounded-pill px-4 w-100">
                            <i class="bi bi-trash3 me-2"></i> Удалить аккаунт
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}